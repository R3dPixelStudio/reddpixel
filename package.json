{
  "name": "reddpixel-last",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:seo": "node --experimental-strip-types scripts/verify-production.mjs",
    "test:oracle": "node --experimental-strip-types scripts/check-oracle.ts",
    "test:content": "node --experimental-strip-types scripts/check-content.ts",
    "test:cube": "node --experimental-strip-types scripts/check-cube.ts",
    "test:navigation": "node scripts/check-navigation.mjs",
    "test:cms": "node scripts/check-cms.mjs",
    "test:security": "node --experimental-strip-types scripts/check-security-media.mjs",
    "preview": "npm run build && wrangler pages dev dist",
    "cms:password": "node scripts/cms-password.mjs",
    "cms:migrate:local": "wrangler d1 migrations apply CMS_DB --local --config wrangler.jsonc",
    "cms:preview": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/three": "^0.184.1",
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.110.0"
  }
}

